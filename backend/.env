DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5175,http://localhost:5173,http://127.0.0.1:5175,http://127.0.0.1:5173
APP_HOST=127.0.0.1
APP_PORT=8001

# Background jobs
REDIS_URL=redis://localhost:6379/0

# LLM (AI Orchestrator) — OpenAI-compatible chat-completions API.
# Leave blank to run with the keyword-match fallback instead of a real LLM.
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5vl:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5vl:3b
OLLAMA_EMBED_MODEL=all-minilm

# Speech-to-text (voice notes / call transcripts). Leave blank to disable transcription.
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1

# Telephony / WhatsApp / SMS (Twilio). Leave blank to disable real calling/sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_WEBHOOK_URL=
# Public URL Twilio/Meta can reach (TwiML, OAuth callbacks, media WS)
# PUBLIC_BASE_URL=http://localhost:8001
PUBLIC_BASE_URL=https://symptoms-jaguar-introduces-highlights.trycloudflare.com
META_OAUTH_REDIRECT_URI=https://symptoms-jaguar-introduces-highlights.trycloudflare.com/api/v1/integrations/facebook/oauth/callback


# Outbound email (SMTP). Leave blank to disable real email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# Meta (Facebook/Instagram/WhatsApp) app — the PLATFORM's own app, not the
# merchant's, so connecting a Page stays a one-click consent for the merchant.
META_APP_ID=1853795219138794
META_APP_SECRET=56175c66170ace93ac78cc14e47f933b
META_OAUTH_REDIRECT_URI=https://symptoms-jaguar-introduces-highlights.trycloudflare.com/api/v1/integrations/facebook/oauth/callback

# Optional non-Meta OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/integrations/google/oauth/callback
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
STRIPE_OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/integrations/stripe/oauth/callback

META_WEBHOOK_VERIFY_TOKEN=shoppilot-dev-verify
META_LOGIN_CONFIG_ID=1729376985208453
